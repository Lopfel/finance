
<div class="lg:col-span-2 min-w-0 bg-[#0f172a] rounded-3xl p-6 md:p-8 border border-slate-800 shadow-sm flex flex-col">

  <% if @selected_stock.present? %>

    <div class="flex flex-col xl:flex-row xl:items-center xl:justify-between gap-5 mb-6">

      <div>
        <h2 class="text-2xl font-bold tracking-tight text-white">
          Market Overview
        </h2>

        <p class="text-sm text-slate-400 mt-1">
          Historical stock performance
        </p>
      </div>

      <%= form_with url: portfolio_path(@portfolio),
                    method: :get,
                    local: true,
                    class: "flex flex-wrap gap-3" do %>

        <%= select_tag :ticker,
              options_from_collection_for_select(
                @stocks,
                :ticker,
                :ticker,
                @selected_stock.ticker
              ),
              class: "rounded-xl border border-slate-800 px-4 py-2 text-sm font-semibold text-slate-700",
              onchange: "this.form.submit()" %>

      <% end %>

    </div>

    <div
      data-controller="candlestick"
      data-candlestick-url-value="<%= historical_prices_portfolio_path(
        @portfolio,
        ticker: @selected_stock.ticker,
        range: @chart_range
      ) %>"
      class="w-full min-w-0">

      <div class="flex flex-wrap items-end justify-between gap-4 mb-6">

        <div>
          <p class="text-xs uppercase tracking-wider font-semibold text-white">
            Last closing price
          </p>

          <div class="flex items-center gap-3 mt-2">
            <span
              data-candlestick-target="price"
              class="text-3xl font-bold text-white">
              --
            </span>

            <span
              data-candlestick-target="change"
              class="text-sm font-semibold px-3 py-1 rounded-full bg-slate-100">
              --
            </span>
          </div>
        </div>

        <div class="flex gap-2">
          <% ["1m", "3m", "6m", "1y"].each do |range| %>
            <button
              type="button"
              data-range="<%= range %>"
              data-action="click->candlestick#changeRange"
              class="px-3 py-2 rounded-lg text-xs font-bold border border-slate-800 text-slate-400 hover:bg-cyan-400 hover:text-white transition">

              <%= range.upcase %>
            </button>
          <% end %>
        </div>

      </div>

      <div class="grid grid-cols-2 md:grid-cols-3 gap-4 mb-6">

        <div class="bg-[#0f172a] rounded-xl border border-slate-900 p-4">
          <p class="text-xs text-slate-400">Period high</p>
          <p
            data-candlestick-target="high"
            class="text-lg font-bold text-white mt-1">
            --
          </p>
        </div>

        <div class="bg-[#0f172a] rounded-xl border border-slate-900 p-4">
          <p class="text-xs text-slate-400">Period low</p>
          <p
            data-candlestick-target="low"
            class="text-lg font-bold text-white mt-1">
            --
          </p>
        </div>

        <div class="bg-[#0f172a] rounded-xl border border-slate-900 p-4 col-span-2 md:col-span-1">
          <p class="text-xs text-slate-400">Previous close</p>
          <p
            data-candlestick-target="previous"
            class="text-lg font-bold text-white mt-1">
            --
          </p>
        </div>

      </div>

      <div
        data-candlestick-target="chart"
        class="w-full min-w-0 h-[380px]">
      </div>

      <p
        data-candlestick-target="message"
        class="text-sm text-slate-400 mt-3">
      </p>

    </div>

  <% else %>

    <div class="py-16 text-center">
      <h2 class="text-xl font-bold text-slate-800">
        No stocks available
      </h2>

      <p class="text-slate-500 mt-2">
        Add stocks to your portfolio to visualize their performance.
      </p>
    </div>

  <% end %>

</div>
