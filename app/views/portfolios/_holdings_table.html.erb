<div class="lg:col-span-2 bg-[#0f172a] rounded-3xl p-8 border border-slate-800 shadow-sm">

    <div class="flex items-center justify-between mb-8">
        <div>
        <h2 class="text-2xl font-bold text-white">
            <%= t("holding.title") %>
        </h2>
        <p class="text-sm text-slate-400 mt-1">
            <%= t("holding.subtitle") %>
        </p>
        </div>

        <%=  button_to rebalance_portfolio_path(@portfolio), method: :post,
            class: "inline-flex items-center gap-2 px-5 py-3 rounded-xl bg-blue-600 hover:bg-blue-500 text-white text-sm font-semibold transition-colors" do %>

        <svg class="w-4 h-4" fill="none" stroke="currentColor"
            viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round"
                stroke-width="2"
                d="M4 4v5h5M20 20v-5h-5M5 9a7 7 0 0112-3l3 3M19 15a7 7 0 01-12 3l-3-3"/>
        </svg>

        <%= t("holding.rebalance") %>
        <% end %>
    </div>

    <div class="overflow-x-auto">
        <%= render Ui::PortfolioTable::Table::Component.new(
            headers: [
            t("holding.stock"),
            t("holding.quantity"),
            t("holding.price"),
            t("holding.market_value"),
            t("holding.current"),
            t("holding.target"),
            t("holding.actions")
            ]
        ) do %>

        <% if @rebalance_actions.present? %>
            <% @rebalance_actions.each do |ticker, recommendation| %>
            <%= render Ui::PortfolioTable::Row::Component.new(
                ticker: ticker,
                recommendation: recommendation
            ) %>
            <% end %>
        <% else %>
            <tr>
            <td colspan="7" class="text-center py-6 text-slate-400">
                <%= t("holding.no_rebalance_recommendations") %>
            </td>
            </tr>
        <% end %>
        <%end%>
    </div>
</div>
