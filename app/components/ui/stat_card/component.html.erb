<div class="h-full min-w-0 rounded-2xl border border-slate-800 bg-[#0f172a] p-5 flex flex-col justify-between shadow-sm hover:border-slate-700 transition-all duration-200">

  <div class="flex items-start justify-between gap-3">
    <span class="text-sm font-medium text-slate-400">
      <%= @title %>
    </span>

    <% if @icon.present? %>
      <span class="text-xl text-slate-500" aria-hidden="true">
        <%= @icon %>
      </span>
    <% end %>
  </div>

  <div class="mt-4">
    <h3 class="text-3xl md:text-4xl font-semibold tracking-tight <%= accent_class %> break-words">
      <%= @value %>
    </h3>

    <% if @subtitle.present? %>
      <p class="mt-2 text-sm text-slate-400">
        <%= @subtitle %>
      </p>
    <% end %>
  </div>

</div>
